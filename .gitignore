# Build output
/dsbox
/dist/

# Runtime data (data_dir default)
/data/

# Local configuration that may hold a management token
/config.local.yaml

# OS
.DS_Store

# Captured TCK output and the connector log from the same run; regenerate
# with `make tck`
/tck-output.txt
/tck-connector.txt

# Linked worktrees for in-progress branches. A worktree here is a full second
# checkout, so leaving it untracked means one `git add -A` on the main checkout
# commits an entire duplicate tree.
/.claude/worktrees/

# Key material the TCK harness generates for itself. Never committed.
test/tck/identities/

# Generated by the demo: keys, roster, the file it moves, and what arrived.
demo/generated/
demo/demo.log

# Generated by `make quickstart`: the script assembled from docs/quickstart.md,
# and the scratch directory that script works in.
/quickstart.sh
/quickstart-run/

# Scratch workspace for subagent-driven-development runs: per-plan ledgers,
# task briefs, and review packages. Never committed — the git history is
# the durable record once a plan finishes.
/.superpowers/
