# Build output
/dsbox
/dist/

# Runtime data (data_dir default)
/data/

# Local configuration that may hold a management token
/config.local.yaml

# OS
.DS_Store

# Captured TCK output and the connector log from the same run; regenerate
# with `make tck`
/tck-output.txt
/tck-connector.txt

# Linked worktrees for in-progress branches. A worktree here is a full second
# checkout, so leaving it untracked means one `git add -A` on the main checkout
# commits an entire duplicate tree.
/.claude/worktrees/

# Key material the TCK harness generates for itself. Never committed.
test/tck/identities/
